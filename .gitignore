# The two Next.js frontends were independent git repositories with their own
# history, and were excluded here so this repo never recorded them as
# gitlinks/submodules. They are now part of this single repository: the nested
# .git directories were removed (the standalone histories are archived outside
# the repo) so the files commit as ordinary files rather than as submodules.
# Their own .gitignore files still apply to their subtrees.

# Assistant project data (memory, session state) — not part of the deliverable
.workbuddy-ai/

# Python
backend/venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Local env / secrets
.env
.env.local
*.local

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
